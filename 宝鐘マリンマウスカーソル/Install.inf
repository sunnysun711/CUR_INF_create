[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg    = Scheme.Reg,Wreg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%pointer%,%10%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%work%,%10%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%Cross%,%10%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%Hand%,%10%\%CUR_DIR%\%Unavailiable%,%10%\%CUR_DIR%\%Vert%,%10%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%Dgn1%,%10%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%move%,%10%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%,%10%\%CUR_DIR%\%locationSelect%,%10%\%CUR_DIR%\%personSelect%",%10%\%CUR_DIR%\%locationSelect%,%10%\%CUR_DIR%\%person_select%

[Wreg]
HKCU,"Control Panel\Cursors",,0x00020000,"%SCHEME_NAME%"
HKCU,"Control Panel\Cursors",AppStarting,0x00020000,"%10%\%CUR_DIR%\%work%"
HKCU,"Control Panel\Cursors",Arrow,0x00020000,"%10%\%CUR_DIR%\%pointer%"
HKCU,"Control Panel\Cursors",Crosshair,0x00020000,"%10%\%CUR_DIR%\%Cross%"
HKCU,"Control Panel\Cursors",Hand,0x00020000,"%10%\%CUR_DIR%\%link%"
HKCU,"Control Panel\Cursors",Help,0x00020000,"%10%\%CUR_DIR%\%Help%"
HKCU,"Control Panel\Cursors",IBeam,0x00020000,"%10%\%CUR_DIR%\%Text%"
HKCU,"Control Panel\Cursors",No,0x00020000,"%10%\%CUR_DIR%\%Unavailiable%"
HKCU,"Control Panel\Cursors",NWPen,0x00020000,"%10%\%CUR_DIR%\%Hand%"
HKCU,"Control Panel\Cursors",SizeAll,0x00020000,"%10%\%CUR_DIR%\%move%"
HKCU,"Control Panel\Cursors",SizeNESW,0x00020000,"%10%\%CUR_DIR%\%Dgn2%"
HKCU,"Control Panel\Cursors",SizeNS,0x00020000,"%10%\%CUR_DIR%\%Vert%"
HKCU,"Control Panel\Cursors",SizeNWSE,0x00020000,"%10%\%CUR_DIR%\%Dgn1%"
HKCU,"Control Panel\Cursors",SizeWE,0x00020000,"%10%\%CUR_DIR%\%Horz%"
HKCU,"Control Panel\Cursors",UpArrow,0x00020000,"%10%\%CUR_DIR%\%alternate%"
HKCU,"Control Panel\Cursors",Wait,0x00020000,"%10%\%CUR_DIR%\%busy%"
HKCU,"Control Panel\Cursors",LocationSelect,0x00020000,"%10%\%CUR_DIR%\%locationSelect%"
HKCU,"Control Panel\Cursors",PersonSelect,0x00020000,"%10%\%CUR_DIR%\%personSelect%"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Runonce\Setup\","",,"rundll32.exe shell32.dll,Control_RunDLL main.cpl @0,1"

[Scheme.Cur]
"宝鐘マリン_01[通常の選択].ani"
"宝鐘マリン_02[ヘルプの選択].ani"
"宝鐘マリン_03[バックグラウンドで作業中].ani"
"宝鐘マリン_04[待ち状態].ani"
"宝鐘マリン_05[領域選択].ani"
"宝鐘マリン_06[テキスト選択].ani"
"宝鐘マリン_07[手書き].ani"
"宝鐘マリン_08[利用不可].ani"
"宝鐘マリン_09[上下に拡大縮小].ani"
"宝鐘マリン_10[左右に拡大縮小].ani"
"宝鐘マリン_11[斜めに拡大縮小1].ani"
"宝鐘マリン_12[斜めに拡大縮小2].ani"
"宝鐘マリン_13[移動].ani"
"宝鐘マリン_14[代替選択].ani"
"宝鐘マリン_15[リンクの選択].ani"
"宝鐘マリン_16_location_select.cur"
"宝鐘マリン_17_person_select.cur"

[Strings]
CUR_DIR = "Cursors\宝鐘マリンマウスカーソル"
SCHEME_NAME = "宝鐘マリンマウスカーソル"
SCHEME_DESCRIPTION = "宝鐘マリンマウスカーソル"
pointer = "宝鐘マリン_01[通常の選択].ani"
help = "宝鐘マリン_02[ヘルプの選択].ani"
work = "宝鐘マリン_03[バックグラウンドで作業中].ani"
busy = "宝鐘マリン_04[待ち状態].ani"
cross = "宝鐘マリン_05[領域選択].ani"
text = "宝鐘マリン_06[テキスト選択].ani"
hand = "宝鐘マリン_07[手書き].ani"
unavailiable = "宝鐘マリン_08[利用不可].ani"
vert = "宝鐘マリン_09[上下に拡大縮小].ani"
horz = "宝鐘マリン_10[左右に拡大縮小].ani"
dgn1 = "宝鐘マリン_11[斜めに拡大縮小1].ani"
dgn2 = "宝鐘マリン_12[斜めに拡大縮小2].ani"
move = "宝鐘マリン_13[移動].ani"
alternate = "宝鐘マリン_14[代替選択].ani"
link = "宝鐘マリン_15[リンクの選択].ani"
locationSelect = "宝鐘マリン_16_location_select.cur"
personSelect = "宝鐘マリン_17_person_select.cur"
